PORT=4000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Proveedor: mercadopago | simulador
PAYMENT_PROVIDER=mercadopago
SIMULATOR_FRONTEND_URL=http://localhost:4200
# Mercado Pago: puede ser local en sandbox; en producción usa HTTPS público.
FRONTEND_URL=http://localhost:4200

# Mercado Pago
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Opcional: webhook público para producción/notificaciones automáticas.
MERCADO_PAGO_NOTIFICATION_URL=
# Secreto entregado al configurar el webhook de Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=