# Servidor
PORT=4000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URLs públicas. En producción deben usar HTTPS.
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4200

# Cloudinary (PDF)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PayU Colombia Web Checkout
# Usa credenciales de PRUEBA mientras PAYU_ENV=test.
PAYU_ENV=test
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=

# Opcional: si se define, sustituye BACKEND_URL + /api/pagos/confirmacion.
# Debe ser una URL pública HTTPS para que PayU pueda enviar el webhook.
PAYU_CONFIRMATION_URL=

# Configura estos valores según la política fiscal/tributaria confirmada para el curso.
PAYU_TAX=0
PAYU_TAX_RETURN_BASE=0
