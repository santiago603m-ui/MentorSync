meta {
  name: Crear Curso
  type: http
}

post {
  url: {{baseUrl}}/api/cursos
  auth: bearer {{token}}
  body: json
}

body:json {
  "titulo": "Curso de Angular avanzado",
  "descripcion": "Aprende Angular con proyectos",
  "categoria": "Programación",
  "precio": 250,
  "duracionEstimadaHoras": 40,
  "estado": "publicado",
  "activo": true
}

docs {
  Este request crea un curso nuevo. 
  La imagen se sube en un paso aparte.
}
​