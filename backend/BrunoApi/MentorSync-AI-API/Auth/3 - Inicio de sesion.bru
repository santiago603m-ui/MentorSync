meta {
  name: Inicio Sesion
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/inicio-sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "email": "mentorprueba@test.com",
  "contraseña": "12345678"
  }
}

vars:post-response {
  token: res.body.data.token
}

script:post-response {
  if (res.body?.data?.token) {
    bru.setVar("token", res.body.data.token);
  }
}

docs {
  Este request inicia sesión con el mentor.
  El script post-response guarda el token JWT en la variable de entorno "token"
  automáticamente, así otros requests lo usan sin copiar/pegar nada.
}
