meta {
  name: 1 - Login administrador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/inicio-sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "email": "admin@mentorsync.ai",
  "contraseña": "admin12345"
  }
}

vars:post-response {
  token: res.body.data.token
  adminId: res.body.data.usuario.id
}

docs {
  Inicia sesión con un usuario rol administrador.
  Guarda el token y el adminId automáticamente para los siguientes requests.
  Si aún no existe el admin: regístralo con Auth/1 y cambia su rol a
  "administrador" directo en Mongo (db.usuarios.updateOne).
}
