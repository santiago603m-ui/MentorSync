meta {
  name: 7 - Error cambiar propio rol
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/usuarios/{{adminId}}/rol
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "rol": "mentor"
  }
}

docs {
  Caso negativo: un admin no puede cambiar su propio rol.
  Debe devolver 403 "No puedes cambiar tu propio rol".
  Usa el adminId guardado por el request 1.
}
